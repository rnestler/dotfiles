{
  "meta": {
    "name": "rails",
    "version": "0.1.0"
  },
  "filesystem": {
    "allow": [
      "$HOME/.cache/rubocop_cache"
    ],
    "read": [
      "$HOME/.local/share/mise/installs/ruby",
      "$HOME/.local/share/mise/installs/node/",
      "$HOME/.local/share/ruby-advisory-db",
      "$HOME/.cache/Cypress",
      "$HOME/.config/yarn"
    ],
    "read_file": [
      "/etc/passwd",
      "~/.yarnrc"
    ],
    "unix_socket": [
      "/var/run/postgresql/.s.PGSQL.5432"
    ]
  },
  "environment": {
    "set_vars": {
      "BUNDLE_USER_CONFIG": "/dev/null"
    }
  },
  "workdir": {
    "access": "readwrite"
  }
}
