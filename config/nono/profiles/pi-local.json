{
  "extends": [
    "nolabs-ai/pi",
    "infomaniak"
  ],
  "meta": {
    "name": "pi-local"
  },
  "workdir": {
    "access": "readwrite"
  },
  "filesystem": {
    "read": [
      "/opt/pi-coding-agent/",
      "$HOME/dotfiles/pi/",
      "/tmp/jiti/"
    ]
  },
  "network": {
    "allow_domain": ["pi.dev"]
  }
}
